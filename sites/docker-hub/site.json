  "regexp": [
    { "pattern": "^Notification center: (\\d+) notifications?$", "flags": "i", "replacement": "通知中心：$1 条通知" },
    { "pattern": "^user menu (.+)$", "flags": "i", "replacement": "$1 的用户菜单" },
    { "pattern": "^(.+) account menu$", "flags": "i", "replacement": "$1 的账户菜单" },
    { "pattern": "^Welcome back,\\s*(.+)!$", "flags": "i", "replacement": "欢迎回来，$1！" },
    { "pattern": "^Deactivate user account\\s+(.+)$", "flags": "i", "replacement": "停用用户账户 $1" },
    { "pattern": "^This action will deactivate and remove access to the user account\\s+(.+)\\.$", "flags": "i", "replacement": "此操作将停用用户账户 $1 并移除其访问权限。" },
    { "pattern": "^Last update: (.+)$", "flags": "i", "replacement": "上次更新：$1" },
    { "pattern": "^Data is available only from (.+)$", "flags": "i", "replacement": "数据仅从 $1 起可用" },
    { "pattern": "^Using (\\d+) of (\\d+) private repositories\\.$", "flags": "i", "replacement": "已使用 $1 / $2 个私有仓库。" },
    { "pattern": "^(\\d+) days? remaining$", "flags": "i", "replacement": "剩余 $1 天" },
    { "pattern": "^\\+(\\d+) more\\.\\.\\.$", "flags": "i", "replacement": "另有 $1 项…" },
    { "pattern": "^([\\d,.]+[KMB]?[+]?) pulls$", "flags": "i", "replacement": "$1 次拉取" },
    { "pattern": "^([\\d,.]+[KMB]?[+]?) stars$", "flags": "i", "replacement": "$1 次收藏" },
    { "pattern": "^Updated (\\d+) days? ago$", "flags": "i", "replacement": "$1 天前更新" },
    { "pattern": "^Updated (\\d+) hours? ago$", "flags": "i", "replacement": "$1 小时前更新" },
    { "pattern": "^Updated about (\\d+) hours? ago$", "flags": "i", "replacement": "约 $1 小时前更新" },
    { "pattern": "^Updated (\\d+) months? ago$", "flags": "i", "replacement": "$1 个月前更新" }
  ],
  "pages": [
    { "pathPrefix": "/_/", "ignoreText": ["h2"] },
    { "pathPrefix": "/r/", "ignoreText": ["h2"] }
  ]
